{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/api/**/*.ts",
    "src/components/scroll/**/*.ts",
    "src/components/layout/route-transitions/**/*.ts",
    "src/features/contact/api/**/*.ts",
