    "src/features/profile/api/**/*.ts",
    "src/features/profile/model/**/*.ts",
    "src/features/profile/presentation/**/*.ts",
    "src/features/projects/api/**/*.ts",
    "src/features/projects/model/**/*.ts",
    "src/features/references/api/**/*.ts",
    "src/features/references/model/**/*.ts",
    "src/features/references/presentation/**/*.ts",
    "src/features/references/storage/**/*.ts",
    "src/features/services/api/**/*.ts",
    "src/features/services/model/**/*.ts",
    "src/features/services/presentation/**/*.ts",
